# Copy this file to .env and fill in your values
# Get your JWT token from: https://learn.01founders.co -> right-click -> Inspect -> Application -> Cookies -> jwt-token
# STUDENT_LOGIN is your username (e.g. tmachado)
# STUDENT_ID is your numeric user ID — found in your profile URL or via the GraphQL API

JWT_TOKEN=your_jwt_token_here
STUDENT_LOGIN=your_username_here
STUDENT_ID=your_numeric_id_here
